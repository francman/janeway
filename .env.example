NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

AWS_REGION=us-east-1
ARTICLES_BUCKET=
ARTICLES_TABLE=janeway-articles
ARTICLES_IMAGE_CDN_URL=
REVALIDATE_SECRET=

# Amplify SSR runtime — Lambda execution doesn't expose its role's credentials,
# so explicit IAM keys are required for prod. Locally these can stay empty and
# the SDK will use AWS_PROFILE / SSO. JANEWAY_AWS_REGION is optional override.
JANEWAY_AWS_REGION=
JANEWAY_AWS_ACCESS_KEY_ID=
JANEWAY_AWS_SECRET_ACCESS_KEY=
